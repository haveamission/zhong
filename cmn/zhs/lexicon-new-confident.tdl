  [ STEM < "马致远" >,
    SYNSEM.LOCAL.CAT.HEAD.CHAR [ FCHAR "马", LENGTH more-than-two ],
    SYNSEM.LKEYS.KEYREL.CARG "马致远",
    TRAITS native_token_list ].

