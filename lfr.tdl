nominalized_v+sentence_end_lfr := lexical_filtering_rule &
  [ +CONTEXT < >,
    +INPUT < [ NOMINALIZED +,
              SYNSEM.LOCAL.CAT.HEAD noun ] >,
    +OUTPUT < >,
    +POSITION "I1<$" ].

