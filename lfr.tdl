;;; -*- Mode: tdl; Coding: utf-8; indent-tabs-mode: nil; -*-

;;;
;;; upon completion of `lexical parsing' (i.e. application of lexical rules
;;; until a fix-point is reached), we can now filter lexical entries.  there is
;;; little point attempting to do that earlier (as PET used to in its original
;;; `-default-les' mode, where generics were only activated where there seemed
;;; to be `gaps' in the _initial_ lexical chart, i.e. after lexical lookup).
;;;
;;; the main problem in this approach is the interaction with orthographemics:
;;; in the initial lexical chart, there will be an edge analysing |UPS| as the
;;; plural or 3sg present tense form of the preposition |up|.  it is only once
;;; lexical rules have been processed that we know such hypotheses have turned
;;; out invalid.  thus, lexical filtering rules below operate on lexical edges,
;;; lexical entries that have gone through any number of lexical rules, i.e.
;;; everything that would ordinarily feed into syntactic rules.
;;; 
;;; initially, our strategy is conservative: whenever there is a native entry,
;;; purge all generic entries in the same chart cell, unless there is a good
;;; reason to keep some.  for now, only capitalization is considered a reason,
;;; and even there (i.e. for generic names), certain types of native entries
;;; will filter.
;;;
;;; both on tokens and signs, the `native' vs. `generic' distinction is made in
;;; +TRAIT: `generic_trait' vs. `native_trait'.
;;;

;;
;; throw out generic whenever a native entry is available
;;
generic_non_ne+native_lfr := lexical_filtering_rule &
 [ +CONTEXT < [ TRAITS native_token_list ] >,
   +INPUT <   [ TRAITS generic_token_list ] >,
   +OUTPUT < >,
   +POSITION "I1@C1" ].

bare_cls+preceding_num_lfr := lexical_filtering_rule &
  [ +CONTEXT < [ SYNSEM.LOCAL.CAT.HEAD num ] >,
    +INPUT < [ SYNSEM.LOCAL.CAT [ HEAD classifier,
                                  VAL.SPR < > ] ] >,
    +OUTPUT < >,
    +POSITION "C1<I1" ].

bare_cls+preceding_det_lfr := lexical_filtering_rule &
  [ +CONTEXT < [ SYNSEM.LOCAL.CAT.HEAD det ] >,
    +INPUT < [ SYNSEM.LOCAL.CAT [ HEAD classifier,
                                  VAL.SPR < > ] ] >,
    +OUTPUT < >,
    +POSITION "C1<I1" ].

bare_cls+preceding_noun_lfr := lexical_filtering_rule &
  [ +CONTEXT < [ SYNSEM.LOCAL.CAT.HEAD noun ] >,
    +INPUT < [ SYNSEM.LOCAL.CAT [ HEAD classifier,
                                  VAL.SPR < > ] ] >,
    +OUTPUT < >,
    +POSITION "C1<I1" ].

bare_cls+coexisting_num_lfr := lexical_filtering_rule &
  [ +CONTEXT < [ SYNSEM.LOCAL.CAT.HEAD num ] >,
    +INPUT < [ SYNSEM.LOCAL.CAT [ HEAD classifier,
                                  VAL.SPR < > ] ] >,
    +OUTPUT < >,
    +POSITION "C1@I1" ].

bare_cls+preceding_cls_lfr := lexical_filtering_rule &
  [ +CONTEXT < [ SYNSEM.LOCAL.CAT.HEAD classifier ] >,
    +INPUT < [ SYNSEM.LOCAL.CAT [ HEAD classifier,
                                  VAL.SPR < > ] ] >,
    +OUTPUT < >,
    +POSITION "C1<I1" ].


;;; Verb nominalization LFRs: remove nominalized verb edges in non-compound

;;; Verb nominalization LFRs: remove nominalized verb edges in non-compound
;;; contexts. The v-nominalization-lex-rule creates noun edges from all
;;; intransitive verbs. These two rules control overgeneration:
;;;
;;; 1. Remove when a native noun already exists at the same position
;;;    (the native entry has correct nominal semantics; the nominalized
;;;    version is redundant)
;;; 2. Remove when NO noun follows at the next position (using negated
;;;    position constraint !C1>I1). This covers all non-compound contexts
;;;    including sentence-final position, pre-verb, pre-adverb, etc.
;;;    in a single rule. The negation also correctly handles the
;;;    ambiguous-following-word case: if the next position has BOTH a
;;;    noun and a verb edge, the nominalization survives (because a noun
;;;    DOES follow), preserving the compound analysis.
;;;
;;; Requires ACE with negation support (! prefix on position constraints).
;;; See the NOMINALIZED feature documentation in cmn.tdl.

nominalized_v+native_noun_lfr := lexical_filtering_rule &
  [ +CONTEXT < [ SYNSEM.LOCAL [ CAT.HEAD noun,
                                CONT.RELS.LIST.FIRST noun-relation ],
                TRAITS native_token_list ] >,
    +INPUT < [ NOMINALIZED +,
              SYNSEM.LOCAL.CAT.HEAD noun ] >,
    +OUTPUT < >,
    +POSITION "C1@I1" ].

nominalized_v+no_following_noun_lfr := lexical_filtering_rule &
  [ +CONTEXT < [ SYNSEM.LOCAL.CAT.HEAD noun ] >,
    +INPUT < [ NOMINALIZED +,
              SYNSEM.LOCAL.CAT.HEAD noun ] >,
    +OUTPUT < >,
    +POSITION "!C1>I1" ].