    +INPUT < [ NOMINALIZED +,
              SYNSEM.LOCAL.CAT.HEAD noun ] >,
    +OUTPUT < >,
    +POSITION "C1>I1" ].

nominalized_v+following_cls_lfr := lexical_filtering_rule &
  [ +CONTEXT < [ SYNSEM.LOCAL.CAT.HEAD classifier ] >,
    +INPUT < [ NOMINALIZED +,
              SYNSEM.LOCAL.CAT.HEAD noun ] >,
