;;; -*- comment-start: ";"; -*-
;;;
;;; Basic repp file, partially customized according
;;; to your choices file.
;;;
;;; 

;===============================================================================
; REPP = Regular Expression Pre-Processing
;===============================================================================


;===============================================================================
; NOTE: if by any chance a token doesn't get a space afterwards, then it will
;       be ignored completely. This is why there must be a space before and
;       after ' \1 '.
;       Tabs are substituted by a space and, finally, more than one space will
;       be substituted by a single space. 
;===============================================================================
:[ \t　]
!^(.+)$								 \1 
!\t							 
!  +								 



;===============================================================================
; QUOTE SPLITTING
;===============================================================================
; Chinese curly quotes sometimes get joined to adjacent tokens by tokenizers.
; Split them off so they are standalone tokens.
;===============================================================================
! “([^ ]+) 							 “ \1 
! ([^ ]+)” 							 \1 ” 
! “([^ ]+) 							 “ \1 
! ‘([^ ]+) 							 ‘ \1 
! ([^ ]+)’ 							 \1 ’ 
;===============================================================================


;===============================================================================
; SEGMENTATION FIXES
;===============================================================================

;===============================================================================
; DETERMINER & NUMBERS & CLASSIFIERS 
;===============================================================================
! (那|这|一|两|每|哪)个 						 \1 个 
! (那|这|一|两|每|哪)条 						 \1 条 
! (那|这|一|两|每|哪)座 						 \1 座 
! (那|这|一|两|每|哪)件 						 \1 件 
! (那|这|一|两|每|哪)位 						 \1 位 
! (那|这|一|两|每|哪)间 						 \1 间 
! (那|这|一|两|每|哪)种 						 \1 种 
! (那|这|一|两|每|哪)些 						 \1 些 

! (一)点儿 							 \1 点儿 

! (几)岁 							 \1 岁 
! ([一二三四五六七八九十百千万]+)岁 							 \1 岁 

! (每)天 							 \1 天 
! (每)次 							 \1 次 
! (哪)些 							 \1 些 

;;; SPLIT CL+NOUN
! (国)人 							 \1 人 
! (封)信 							 \1 信 
! (分)钟 							 \1 钟 
! (刻)钟 							 \1 钟 


